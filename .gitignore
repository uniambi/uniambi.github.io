# Publish website files; keep local tooling and provenance off GitHub.
/*
!/.gitignore
!/.nojekyll
!/README.md
!/index.html
!/styles.css
!/app.js
!/audio.js
!/panorama.js
!/video-cache.js
!/data.json
!/previews.json
!/assets/
!/previews/
!/vendor/

# Source metadata and local editor files are not used by the website.
/assets/**/*.jsonl
**/.DS_Store
**/*.pkf
**/__pycache__/
